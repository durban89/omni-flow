LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
# Optional free fallback for content generation (Groq, OpenAI-compatible).
# Create a key at https://console.groq.com/keys — the free tier needs no card.
GROQ_API_KEY=

CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Optional override; leave empty so the active mode picks the Pages project
# (test -> condom-iq-dev, production -> condom-iq).
CLOUDFLARE_PAGES_PROJECT=
CLOUDFLARE_ZONE_ID=

# KV namespace IDs (created with `npx wrangler kv namespace create <name>`).
# production mode syncs to _PROD, test mode to _DEV. Optional override wins over both.
CLOUDFLARE_KV_NAMESPACE_ID_PROD=
CLOUDFLARE_KV_NAMESPACE_ID_DEV=
CLOUDFLARE_KV_NAMESPACE_ID=
